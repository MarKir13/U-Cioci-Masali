# Copy to deploy/.env and change the passwords. deploy/.env is gitignored.

# Database
DB_NAME=prestashop
DB_USER=prestashop
DB_PASSWORD=change_me
DB_ROOT_PASSWORD=change_me_root

# Shop
# HTTP only redirects to HTTPS; open the shop at https://localhost:<HTTPS_PORT>
HTTP_PORT=8080
HTTPS_PORT=8443
PS_FOLDER_ADMIN=admin-ciocia
ADMIN_MAIL=admin@ciocia.local
ADMIN_PASSWORD=change_me_Admin1

# Mailpit web UI (shop e-mails), bound to 127.0.0.1 only
MAILPIT_PORT=8025
