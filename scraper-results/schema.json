{
  "$defs": {
    "Brand": {
      "additionalProperties": false,
      "description": "The page of a brand (`/brand/<id>-<slug>`) on the source. The result file has one record per brand of the\nproducts, so a brand without a page has only `name`: everything else is optional (and reported by the crawl).",
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "title": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "description": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "faq_title": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Faq Title"
        },
        "faq": {
          "items": {
            "$ref": "#/$defs/FaqItem"
          },
          "title": "Faq",
          "type": "array"
        },
        "meta_title": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Meta Title"
        },
        "meta_description": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Meta Description"
        }
      },
      "required": [
        "name"
      ],
      "title": "Brand",
      "type": "object"
    },
    "Category": {
      "additionalProperties": false,
      "description": "A category or subcategory. `parent_id` is null for top-level categories.",
      "properties": {
        "id": {
          "exclusiveMinimum": 0,
          "title": "Id",
          "type": "integer"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Url",
          "type": "string"
        },
        "parent_id": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Parent Id"
        },
        "description": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "position": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Position"
        }
      },
      "required": [
        "id",
        "name",
        "url",
        "parent_id"
      ],
      "title": "Category",
      "type": "object"
    },
    "FamilyAxis": {
      "additionalProperties": false,
      "description": "One row of a family block, such as \"Mydło\" (photo tiles) or \"Pojemność\" (text buttons).",
      "properties": {
        "title": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "kind": {
          "enum": [
            "image",
            "text"
          ],
          "title": "Kind",
          "type": "string"
        },
        "options": {
          "items": {
            "$ref": "#/$defs/FamilyOption"
          },
          "minItems": 1,
          "title": "Options",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "options"
      ],
      "title": "FamilyAxis",
      "type": "object"
    },
    "FamilyOption": {
      "additionalProperties": false,
      "description": "One tile or button of a family block: the source id of the product it stands for and the short label on it.",
      "properties": {
        "source_id": {
          "exclusiveMinimum": 0,
          "title": "Source Id",
          "type": "integer"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "label"
      ],
      "title": "FamilyOption",
      "type": "object"
    },
    "FaqItem": {
      "additionalProperties": false,
      "description": "One question of a brand's FAQ. `answer` is HTML (paragraphs).",
      "properties": {
        "question": {
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "answer": {
          "minLength": 1,
          "title": "Answer",
          "type": "string"
        }
      },
      "required": [
        "question",
        "answer"
      ],
      "title": "FaqItem",
      "type": "object"
    },
    "Image": {
      "additionalProperties": false,
      "description": "A product image. `local_path` is filled in once the file has been downloaded.",
      "properties": {
        "source_url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Source Url",
          "type": "string"
        },
        "local_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Local Path"
        }
      },
      "required": [
        "source_url"
      ],
      "title": "Image",
      "type": "object"
    },
    "Product": {
      "additionalProperties": false,
      "description": "A product. Variants are separate products, linked through `family`.",
      "properties": {
        "id": {
          "exclusiveMinimum": 0,
          "title": "Id",
          "type": "integer"
        },
        "url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Url",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "description_short": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description Short"
        },
        "price": {
          "pattern": "^\\d+(\\.\\d{1,2})?$",
          "title": "Price",
          "type": "string"
        },
        "regular_price": {
          "pattern": "^\\d+(\\.\\d{1,2})?$",
          "title": "Regular Price",
          "type": "string"
        },
        "has_discount": {
          "title": "Has Discount",
          "type": "boolean"
        },
        "promo_end": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Promo End"
        },
        "vat_rate": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vat Rate"
        },
        "brand": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Brand"
        },
        "ean": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ean"
        },
        "size": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Size"
        },
        "color": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Color"
        },
        "material": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Material"
        },
        "pattern": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pattern"
        },
        "weight": {
          "anyOf": [
            {
              "$ref": "#/$defs/RawWeight"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "family": {
          "items": {
            "format": "uri",
            "maxLength": 2083,
            "minLength": 1,
            "type": "string"
          },
          "title": "Family",
          "type": "array"
        },
        "category_ids": {
          "items": {
            "exclusiveMinimum": 0,
            "type": "integer"
          },
          "minItems": 1,
          "title": "Category Ids",
          "type": "array"
        },
        "images": {
          "items": {
            "$ref": "#/$defs/Image"
          },
          "minItems": 1,
          "title": "Images",
          "type": "array"
        }
      },
      "required": [
        "id",
        "url",
        "name",
        "description",
        "price",
        "regular_price",
        "has_discount",
        "category_ids",
        "images"
      ],
      "title": "Product",
      "type": "object"
    },
    "ProductFamily": {
      "additionalProperties": false,
      "description": "The family block of one product page (`families.json` stores `axes` under the product id).",
      "properties": {
        "product_id": {
          "exclusiveMinimum": 0,
          "title": "Product Id",
          "type": "integer"
        },
        "axes": {
          "items": {
            "$ref": "#/$defs/FamilyAxis"
          },
          "minItems": 1,
          "title": "Axes",
          "type": "array"
        }
      },
      "required": [
        "product_id",
        "axes"
      ],
      "title": "ProductFamily",
      "type": "object"
    },
    "RawWeight": {
      "additionalProperties": false,
      "description": "Weight exactly as on the page. The unit is unreliable, so it is converted only on import.",
      "properties": {
        "value": {
          "minLength": 1,
          "title": "Value",
          "type": "string"
        },
        "unit": {
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "title": "RawWeight",
      "type": "object"
    }
  },
  "title": "Scraper results"
}
