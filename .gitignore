# --- Secrets and local configuration ---
.env
.env.*
!.env.example

# --- Certificates and private keys ---
deploy/certs/
*.key
*.pem
*.crt

# --- Dependencies ---
vendor/
node_modules/

# --- PrestaShop runtime data ---
var/cache/
var/logs/
upload/
download/
img/p/
img/c/
img/tmp/

# --- Logs ---
*.log
logs/

# --- Backups and archives (images go to GitHub Releases, not git) ---
backups/
*.zip
*.tar.gz

# --- Python ---
.venv/
__pycache__/
*.pyc
.pytest_cache/

# --- Scraper output too large for git (full image set goes to GitHub Releases) ---
scraper-results/images/
scraper/cache/
# Left behind only if a results file was being written when the crawl was interrupted
scraper-results/*.tmp

# --- Playwright reports  ---
tests/test-results/
tests/playwright-report/
# --- Claude Code: PR checkouts made by the review-prs skill ---
.claude/worktrees/

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/
